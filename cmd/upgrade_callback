#!/bin/bash
### MoviePilot 升级后：恢复配置、校验依赖、重启
set -u

APP_NAME="moviepilot"
CONFIG_DIR="${TRIM_PKGVAR}/config"
MP_SRC="${TRIM_APPDEST}/mp"
# set -u 兜底：共享路径未导出时退回包数据目录（同为持久目录）
SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}"
DATA_SHARE="${SHARE_PATHS%%:*}"
[ -n "${DATA_SHARE}" ] || DATA_SHARE="${TRIM_PKGVAR}"
BACKUP_DIR="${DATA_SHARE}/.moviepilot_backup"

PYTHON_BIN="/var/apps/python312/target/bin/python3"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${TRIM_PKGVAR}/upgrade.log"; }

CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
# shellcheck source=lib.sh
. "${CMD_DIR}/lib.sh" 2>/dev/null || true

# 运行时解析（顺序即优先级）：
#   1. app/python          —— 构建时打包的自带 CPython 3.14 + 全部依赖
#   2. app/venv            —— 历史版本打包的 venv（升级兼容）
#   3. ${TRIM_PKGVAR}/venv —— 用 fnOS python312 在线创建（兜底）
BUNDLED_RUNTIME="${TRIM_APPDEST}/python"
RUNTIME_BUNDLED=0
if [ -x "${BUNDLED_RUNTIME}/bin/python3" ]; then
    VENV_DIR="${BUNDLED_RUNTIME}"
    RUNTIME_BUNDLED=1
elif [ -x "${TRIM_APPDEST}/venv/bin/python" ]; then
    VENV_DIR="${TRIM_APPDEST}/venv"
    RUNTIME_BUNDLED=1
else
    VENV_DIR="${TRIM_PKGVAR}/venv"
fi
# pip 一律用 "${PYTHON}" -m pip：自带运行时的 bin/pip 是相对路径 trampoline
# （依赖系统 realpath），用 -m pip 少依赖一个外部命令且两种布局都成立
PYTHON="${VENV_DIR}/bin/python3"
[ -x "${PYTHON}" ] || PYTHON="${VENV_DIR}/bin/python"

# 恢复备份的配置（新装时 TRIM_PKGVAR 可能被清空）
if [ -d "${BACKUP_DIR}/config" ] && [ ! -f "${CONFIG_DIR}/app.env" ]; then
    mkdir -p "${CONFIG_DIR}"
    cp -a "${BACKUP_DIR}/config/." "${CONFIG_DIR}/" 2>/dev/null || true
fi

# 恢复后的 app.env 经 cp -a 保留了原属主/权限，可能不属于运行用户。
# 统一交给 mp_secure_config 收敛（递归：安装阶段由 root 创建的数据库文件
# 同样需要归属运行用户，否则后端写库会失败）。
mp_secure_config "${CONFIG_DIR}" "${CONFIG_DIR}/app.env" 1 || {
    # lib.sh 缺失（异常安装）时退回宽松权限，保证后端可写
    chmod 777 "${CONFIG_DIR}" 2>/dev/null || true
    if [ -f "${CONFIG_DIR}/app.env" ]; then
        chmod 666 "${CONFIG_DIR}/app.env" 2>/dev/null || true
    fi
}

# venv 不存在时先创建：从"内嵌运行时"的包升级到"在线安装"的包时，VENV_DIR 会
# 指向从未创建过的 ${TRIM_PKGVAR}/venv，后续 pip 调用会让所有镜像源都失败并
# 中断升级。自带运行时（RUNTIME_BUNDLED=1）自带解释器，无需建 venv。
if [ "${RUNTIME_BUNDLED}" != "1" ] \
        && [ ! -x "${VENV_DIR}/bin/python3" ] && [ ! -x "${VENV_DIR}/bin/python" ]; then
    log "venv 不存在，创建：${VENV_DIR}"
    "${PYTHON_BIN}" -m venv "${VENV_DIR}" >> "${TRIM_PKGVAR}/upgrade.log" 2>&1 || {
        {
            echo "升级失败：Python 虚拟环境创建失败（${VENV_DIR}）"
            echo "--------------------------------------------------"
            tail -n 40 "${TRIM_PKGVAR}/upgrade.log" 2>/dev/null
        } > "$TRIM_TEMP_LOGFILE"
        exit 1
    }
    PYTHON="${VENV_DIR}/bin/python3"
    [ -x "${PYTHON}" ] || PYTHON="${VENV_DIR}/bin/python"
fi

# 确保 Python 依赖完整（非打包 venv 时在线补齐）
# 优化：大多数升级只是改代码、依赖不变。若 venv 依赖已安装且校验通过（秒级 pip check），
#       直接跳过耗时的 pip install，只做数据库迁移，把升级从"重装全部依赖"缩短到几秒。
#       仅当依赖确实缺失（pip check 失败）或从未装过时才走完整 pip install。
NEED_INSTALL=0
if [ "${RUNTIME_BUNDLED}" = "1" ]; then
    NEED_INSTALL=0
    # 升级会整包替换应用目录，自带运行时也随之被换成新包里的那份。这里同样做一次
    # 自检：新包若因缺 wheel / glibc 过新而不可用，必须让升级明确失败，否则会
    # 留下一个"升级成功但起不来"的应用，且旧版本已被覆盖、无法回退。
    if ! "${PYTHON}" -c "import fastapi, uvicorn, sqlalchemy, pydantic" \
            >> "${TRIM_PKGVAR}/upgrade.log" 2>&1; then
        {
            echo "升级失败：新版本自带的 Python 运行时缺少核心依赖，已终止升级"
            echo "--------------------------------------------------"
            tail -n 40 "${TRIM_PKGVAR}/upgrade.log" 2>/dev/null
        } > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    log "自带运行时自检通过：$("${PYTHON}" -V 2>&1)"
elif [ ! -f "${VENV_DIR}/.deps_done" ]; then
    NEED_INSTALL=1
else
    if "${PYTHON}" -m pip check >> "${TRIM_PKGVAR}/upgrade.log" 2>&1; then
        NEED_INSTALL=0
    else
        NEED_INSTALL=1
    fi
fi

if [ "${NEED_INSTALL}" = "1" ]; then
    # 依赖清单用构建时从 uv.lock 导出的 requirements.lock.txt：
    # 上游 V3 起已不再提供 requirements.txt，沿用旧路径必然失败。
    REQ_FILE="${MP_SRC}/requirements.lock.txt"
    [ -f "${REQ_FILE}" ] || REQ_FILE="${MP_SRC}/requirements.txt"
    if [ ! -f "${REQ_FILE}" ]; then
        {
            echo "升级失败：未找到依赖清单（requirements.lock.txt / requirements.txt）"
            echo "--------------------------------------------------"
            tail -n 40 "${TRIM_PKGVAR}/upgrade.log" 2>/dev/null
        } > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    PIP_MIRRORS=(
        "https://mirrors.aliyun.com/pypi/simple/"
        "https://mirrors.cloud.tencent.com/pypi/simple/"
        "https://pypi.tuna.tsinghua.edu.cn/simple/"
        "https://pypi.org/simple/"
    )
    PIP_OK=0
    for mirror in "${PIP_MIRRORS[@]}"; do
        if "${PYTHON}" -m pip install -r "${REQ_FILE}" \
                -i "${mirror}" \
                --trusted-host "$(echo "${mirror}" | sed -E 's#https?://([^/]+)/.*#\1#')" \
                >> "${TRIM_PKGVAR}/upgrade.log" 2>&1; then
            PIP_OK=1
            break
        fi
    done
    # 全部镜像失败必须终止升级：不能标记 .deps_done，否则带着缺依赖的
    # venv 启动后端只会崩溃循环
    if [ "${PIP_OK}" != "1" ]; then
        {
            echo "升级失败：Python 依赖安装失败（所有镜像源均不可用），最近日志："
            echo "--------------------------------------------------"
            tail -n 40 "${TRIM_PKGVAR}/upgrade.log" 2>/dev/null
        } > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    touch "${VENV_DIR}/.deps_done"
fi

# 数据库结构迁移（用子 shell 切换 cwd，避免影响后续步骤的工作目录）
if [ -x "${PYTHON}" ] && [ -d "${MP_SRC}" ]; then
    (
        cd "${MP_SRC}" && \
        CONFIG_DIR="${CONFIG_DIR}" "${PYTHON}" -c "
try:
    # V3 官方入口：先校验 revision 链，必要时先迁移再建表，避免旧库 create_all 冲突
    from app.startup.initializers.database import prepare_database
except ImportError:
    from app.db.init import init_db, update_db
    init_db()
    update_db()
else:
    prepare_database()
"
    ) >> "${TRIM_PKGVAR}/upgrade.log" 2>&1 || true
fi

# venv 属主修正：升级会整包替换应用目录，内嵌 venv 会重新变成 root 属主；
# 后端需要用它自己的 pip 安装插件依赖（market.py 走 sys.executable 的 pip），
# 不修正会导致插件安装 PermissionError。
mp_secure_venv "${VENV_DIR}" || true

# 重启服务使新版本代码生效。幂等：应用未运行时 start，运行中则 restart。
# 若不重启，新版本要等到用户下次手动启停才生效。
if [ -x "${TRIM_APPDEST}/cmd/main" ]; then
    log "重启应用使新版本生效 ..."
    "${TRIM_APPDEST}/cmd/main" restart >> "${TRIM_PKGVAR}/upgrade.log" 2>&1 \
        || log "警告: 应用重启失败，请手动启动应用"
fi

# 清理备份
rm -rf "${BACKUP_DIR}"

exit 0
