#!/bin/bash
### MoviePilot fnOS 原生应用 - 生命周期控制（start/stop/status）
### 统一由 supervisor.py（Python 主管进程）管理后端/前端/网关代理三个服务。
### fnOS 只追踪 supervisor 一个主进程，避免子进程被 fnOS 进程管理清理。
set -u

APP_NAME="moviepilot"
export PATH="/var/apps/nodejs_v24/target/bin:${PATH}"

CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
# shellcheck source=lib.sh
. "${CMD_DIR}/lib.sh" 2>/dev/null || true

MP_SRC="${TRIM_APPDEST}/mp"
BIN_DIR="${TRIM_APPDEST}/bin"
FRONTEND_DIR="${TRIM_APPDEST}/frontend"
CONFIG_DIR="${TRIM_PKGVAR}/config"

# 运行时解析：优先构建时打包的自带 Python 3.14（app/python），其次历史版本的
# venv，最后安装时在线创建的 venv。lib.sh 缺失（异常安装）时退回内联判断，
# 保证本脚本自身仍可用。
if command -v mp_runtime_dir >/dev/null 2>&1; then
    VENV_DIR="$(mp_runtime_dir || echo "${TRIM_PKGVAR}/venv")"
    PYTHON_BIN="$(mp_any_python || echo "/var/apps/python312/target/bin/python3")"
    APP_PYTHON="$(mp_app_python || echo "${VENV_DIR}/bin/python")"
else
    if [ -x "${TRIM_APPDEST}/python/bin/python3" ]; then
        VENV_DIR="${TRIM_APPDEST}/python"
    elif [ -x "${TRIM_APPDEST}/venv/bin/python" ]; then
        VENV_DIR="${TRIM_APPDEST}/venv"
    else
        VENV_DIR="${TRIM_PKGVAR}/venv"
    fi
    PYTHON_BIN="/var/apps/python312/target/bin/python3"
    # 自带运行时与 venv 的差异：前者同时有 bin/python3 与 bin/python，后者通常
    # 只有 bin/python3（python3 -m venv 在部分版本不建 bin/python）。
    if [ -x "${VENV_DIR}/bin/python3" ]; then
        APP_PYTHON="${VENV_DIR}/bin/python3"
    else
        APP_PYTHON="${VENV_DIR}/bin/python"
    fi
fi

SUPERVISOR="${BIN_DIR}/supervisor.py"
SUPER_PID_FILE="${TRIM_PKGTMP}/${APP_NAME}-super.pid"
LOG_FILE="${TRIM_PKGVAR}/${APP_NAME}.log"
GATEWAY_SOCK="${TRIM_APPDEST}/${APP_NAME}.sock"
MP_UPDATER="${BIN_DIR}/mp_updater.py"
MP_RESOURCES="${BIN_DIR}/mp_resources.py"
UPDATE_LOG="${TRIM_PKGVAR}/update.log"

# 共享目录（用于写诊断日志，trim-cli 可读取）；未导出时跳过共享日志
SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}"
if [ -n "$SHARE_PATHS" ]; then
    SHARE_LOG="${SHARE_PATHS%%:*}/${APP_NAME}-supervisor.log"
else
    SHARE_LOG=""
fi

# 端口（从 app.env 读取）
BACKEND_PORT=3002
FRONTEND_PORT=3005
if [ -f "${CONFIG_DIR}/app.env" ]; then
    v=$(grep -E '^PORT=' "${CONFIG_DIR}/app.env" | tail -1 | cut -d= -f2)
    [ -n "$v" ] && BACKEND_PORT="$v"
    v=$(grep -E '^NGINX_PORT=' "${CONFIG_DIR}/app.env" | tail -1 | cut -d= -f2)
    [ -n "$v" ] && FRONTEND_PORT="$v"
fi

LOG_MAX_SIZE=2097152
LOG_MAX_FILES=3

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"; }

is_pid_alive() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

rotate_logs() {
    if [ -f "$LOG_FILE" ]; then
        size=$(stat -c%s "$LOG_FILE" 2>/dev/null || stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)
        if [ "$size" -gt "$LOG_MAX_SIZE" ]; then
            [ -f "${LOG_FILE}.${LOG_MAX_FILES}" ] && rm -f "${LOG_FILE}.${LOG_MAX_FILES}"
            for i in $(seq $((LOG_MAX_FILES - 1)) -1 1); do
                [ -f "${LOG_FILE}.${i}" ] && mv "${LOG_FILE}.${i}" "${LOG_FILE}.$((i + 1))"
            done
            # copytruncate 语义：绝不能用 mv 轮转。supervisor 及其子进程（前端/代理）
            # 以 append 模式长期持有本文件的 fd，mv 之后它们仍写原 inode，日志会被
            # 割裂到 moviepilot.log.1；改为复制后清空，所有写入者继续落在同一 inode。
            cp -p "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null || true
            : > "$LOG_FILE"
            echo "$(date '+%Y-%m-%d %H:%M:%S') - Log rotated" >> "$LOG_FILE"
        fi
    fi
}

get_super_pid() {
    if [ -f "$SUPER_PID_FILE" ]; then
        p=$(cat "$SUPER_PID_FILE" 2>/dev/null)
        if is_pid_alive "$p"; then
            echo "$p"
            return
        fi
    fi
    # 必须用本应用的绝对路径匹配：只写 "bin/supervisor.py" 会命中其他 fnOS
    # 应用的同名脚本（它们同样位于 <appdir>/bin/supervisor.py），导致 is_running
    # 误判为"运行中"（应用永远起不来），stop 时更会误杀别的应用的主进程。
    pgrep -f "${BIN_DIR}/supervisor\.py" 2>/dev/null | head -1
}

is_running() {
    p=$(get_super_pid)
    [ -n "$p" ]
}

# ---------------------------------------------------------------------------
# 自更新：启动前检查上游 Release 并就地升级
# ---------------------------------------------------------------------------
# 上游发新版本时无需重新构建 fpk —— mp_updater.py 会下载新版后端源码与前端
# dist 就地替换，随后本脚本照常用新代码启动。更新失败一律不影响启动：
# 更新器内部已回滚，这里只记录退出码。
#   --auto  ：遵守 app.env 的 MP_AUTO_UPDATE 开关与检查冷却（启动路径用）
#   --force ：忽略开关与冷却（手动 update 子命令用）
# 退出码：0 无需更新 / 10 已更新 / 124 超时 / 其它 失败
run_updater() {
    [ -f "$MP_UPDATER" ] || { log "跳过更新检查：缺少 ${MP_UPDATER}"; return 0; }
    [ -x "$APP_PYTHON" ] || { log "跳过更新检查：Python 运行时不存在（${APP_PYTHON}）"; return 0; }
    mkdir -p "${TRIM_PKGTMP}"
    export MP_SRC FRONTEND_DIR CONFIG_DIR APP_PYTHON TRIM_PKGTMP SHARE_LOG
    export MP_UPDATE_LOG="$UPDATE_LOG"
    local rc=0
    log "==> 检查上游更新（$*）"
    if command -v timeout >/dev/null 2>&1; then
        timeout "${MP_UPDATE_TIMEOUT:-600}" "$APP_PYTHON" "$MP_UPDATER" "$@" \
            >> "$UPDATE_LOG" 2>&1 || rc=$?
    else
        # 没有 coreutils timeout 时直接跑（更新器自身对各步都有超时）
        "$APP_PYTHON" "$MP_UPDATER" "$@" >> "$UPDATE_LOG" 2>&1 || rc=$?
    fi
    case "$rc" in
        0)   log "==> 无需更新" ;;
        10)  log "==> 已应用上游更新，修正运行时权限"
             # pip 以 root 身份补装过依赖，把 site-packages/bin 交还应用运行用户，
             # 否则 MoviePilot 运行时安装插件依赖会 PermissionError
             if command -v mp_runtime_dir >/dev/null 2>&1; then
                 mp_secure_venv "$(mp_runtime_dir 2>/dev/null || echo "${VENV_DIR}")" 2>/dev/null || true
             fi
             ;;
        124) log "==> 更新检查超时（${MP_UPDATE_TIMEOUT:-600}s），继续使用当前版本" ;;
        *)   log "==> 更新检查未完成（rc=$rc），继续使用当前版本" ;;
    esac
    return $rc
}

# ---------------------------------------------------------------------------
# 站点资源自愈：sites 扩展在独立仓库，且其目录随上游重构搬过家
# （app/helper → ... → app/application/site）。老包 + 自更新到新版代码的组合
# 会出现"资源留在旧目录、新代码找不到"而起不来。这里在启动前按当前源码结构
# 重新对位，纯文件复制、幂等、无网络，失败也不阻塞启动。
# ---------------------------------------------------------------------------
repair_resources() {
    [ -f "$MP_RESOURCES" ] || return 0
    [ -x "$APP_PYTHON" ] || return 0
    export MP_SRC
    local rc=0
    "$APP_PYTHON" "$MP_RESOURCES" >> "$UPDATE_LOG" 2>&1 || rc=$?
    case "$rc" in
        0) log "==> 站点资源检查通过" ;;
        1) log "==> 警告：站点资源缺失且本机无法修复（详见 ${UPDATE_LOG}），后端可能启动失败" ;;
        *) log "==> 站点资源检查未完成（rc=$rc），继续启动" ;;
    esac
    return 0
}

start_app() {
    if is_running; then
        return 0
    fi
    if [ ! -f "$SUPERVISOR" ]; then
        echo "错误：主管进程脚本不存在" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi
    if [ ! -x "$APP_PYTHON" ]; then
        echo "错误：Python 运行时不存在（${APP_PYTHON}），请重新安装应用" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi
    rm -f "$GATEWAY_SOCK"
    log "启动主管进程 ..."
    nohup env \
        MP_SRC="$MP_SRC" VENV_DIR="$VENV_DIR" BIN_DIR="$BIN_DIR" \
        FRONTEND_DIR="$FRONTEND_DIR" CONFIG_DIR="$CONFIG_DIR" \
        BACKEND_PORT="$BACKEND_PORT" FRONTEND_PORT="$FRONTEND_PORT" \
        GATEWAY_SOCK="$GATEWAY_SOCK" LOG_FILE="$LOG_FILE" \
        SHARE_LOG="$SHARE_LOG" PYTHON_BIN="$PYTHON_BIN" \
        "$APP_PYTHON" "$SUPERVISOR" >> "$LOG_FILE" 2>&1 &
    echo $! > "$SUPER_PID_FILE"
    disown 2>/dev/null || true
    # 确认主管进程存活
    local i=0
    while [ $i -lt 20 ]; do   # 最长 10 秒
        if is_pid_alive "$(cat "$SUPER_PID_FILE")"; then
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done
    echo "错误：主管进程启动失败" > "$TRIM_TEMP_LOGFILE"
    tail -20 "$LOG_FILE" >> "$TRIM_TEMP_LOGFILE"
    rm -f "$SUPER_PID_FILE"
    return 1
}

stop_app() {
    p=$(get_super_pid)
    if [ -n "$p" ]; then
        log "停止主管进程 pid=$p ..."
        kill "$p" 2>/dev/null || true
        local timeout=30
        while is_pid_alive "$p" && [ $timeout -gt 0 ]; do
            sleep 1
            timeout=$((timeout - 1))
        done
        is_pid_alive "$p" && kill -9 "$p" 2>/dev/null || true
    fi
    # 兜底：清理残留的后端/前端/代理进程
    # 一律使用本应用的绝对路径（${MP_SRC}/${BIN_DIR}）匹配，避免误杀其他应用的
    # 同名脚本进程（后端以绝对路径启动，前端/代理脚本路径同样唯一）。
    pgrep -f "${MP_SRC}/app/main\.py" 2>/dev/null | xargs -r kill -9 2>/dev/null || true
    pgrep -f "${BIN_DIR}/frontend-server\.js" 2>/dev/null | xargs -r kill -9 2>/dev/null || true
    pgrep -f "${BIN_DIR}/gateway-proxy\.py" 2>/dev/null | xargs -r kill -9 2>/dev/null || true
    rm -f "$SUPER_PID_FILE" "$GATEWAY_SOCK"
}

mkdir -p "$TRIM_PKGTMP"
rotate_logs

case "${1:-}" in
start)
    log "=== start ==="
    # 密钥兜底：app.env 是 SECRET_KEY / RESOURCE_SECRET_KEY 的唯一来源，缺了后端会
    # 退化成"每次启动随机生成"，后果是登录态与站点索引（以及只认资源 Cookie 的
    # EventSource 接口）全部作废。install / upgrade / config 三条路径都会补，但
    # "覆盖安装换上旧模板 / 从旧备份恢复 / 手工改坏"等场景仍可能缺失，这里在启动前
    # 统一兜一次。幂等：只补缺失键，已有值绝不覆盖（轮换密钥会让旧签名与已加密的
    # 站点索引永久不可用）。
    if command -v mp_env_ensure_secret >/dev/null 2>&1; then
        mp_env_ensure_secret "${CONFIG_DIR}/app.env" "SECRET_KEY"
        mp_env_ensure_secret "${CONFIG_DIR}/app.env" "RESOURCE_SECRET_KEY"
    fi
    # 重启即升级：只在真正需要时才会下载（有版本才联网），失败不影响启动。
    if [ "${MP_SKIP_UPDATE:-}" != "1" ]; then
        run_updater --auto || true
    fi
    # 更新器会替换整个 app/，资源回填有可能落在旧目录，启动前统一对位一次
    repair_resources
    start_app || exit 1
    log "=== started ==="
    exit 0
    ;;
update)
    # 手动立即更新（忽略冷却）：供 trim-cli / 命令行排查使用，fnOS 不会主动调用
    log "=== 手动更新 ==="
    was_running=0
    if is_running; then
        was_running=1
        "$0" stop
        sleep 2
    fi
    run_updater --force || true
    tail -n 30 "$UPDATE_LOG" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    if [ "$was_running" = "1" ]; then
        "$0" start
    fi
    exit 0
    ;;
update-check)
    # 只检查不更新，结果写入 update.log 与临时日志文件
    log "=== 更新检查 ==="
    run_updater --check --force || true
    tail -n 30 "$UPDATE_LOG" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    exit 0
    ;;
repair)
    # 手动修复站点资源（sites 扩展错位/缺失导致后端起不来时）
    log "=== 修复站点资源 ==="
    repair_resources
    tail -n 30 "$UPDATE_LOG" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    exit 0
    ;;
rollback)
    # 回滚到最近一次更新前的备份（更新后启动异常时的逃生通道）
    log "=== 回滚更新 ==="
    was_running=0
    if is_running; then
        was_running=1
        "$0" stop
        sleep 2
    fi
    run_updater --rollback || true
    tail -n 30 "$UPDATE_LOG" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    if [ "$was_running" = "1" ]; then
        "$0" start
    fi
    exit 0
    ;;
stop)
    log "=== stop ==="
    stop_app
    log "=== stopped ==="
    exit 0
    ;;
restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;
status)
    if is_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status|update|update-check|rollback|repair}" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
