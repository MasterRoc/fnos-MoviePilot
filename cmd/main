#!/bin/bash
### MoviePilot fnOS 原生应用 - 生命周期控制（start/stop/status）
### 统一由 supervisor.py（Python 主管进程）管理后端/前端/网关代理三个服务。
### fnOS 只追踪 supervisor 一个主进程，避免子进程被 fnOS 进程管理清理。
set -u

APP_NAME="moviepilot"
export PATH="/var/apps/nodejs_v24/target/bin:${PATH}"

CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
# shellcheck source=lib.sh
. "${CMD_DIR}/lib.sh" 2>/dev/null || true

MP_SRC="${TRIM_APPDEST}/mp"
BIN_DIR="${TRIM_APPDEST}/bin"
FRONTEND_DIR="${TRIM_APPDEST}/frontend"
CONFIG_DIR="${TRIM_PKGVAR}/config"

# 运行时解析：优先构建时打包的自带 Python 3.14（app/python），其次历史版本的
# venv，最后安装时在线创建的 venv。lib.sh 缺失（异常安装）时退回内联判断，
# 保证本脚本自身仍可用。
if command -v mp_runtime_dir >/dev/null 2>&1; then
    VENV_DIR="$(mp_runtime_dir || echo "${TRIM_PKGVAR}/venv")"
    PYTHON_BIN="$(mp_any_python || echo "/var/apps/python312/target/bin/python3")"
    APP_PYTHON="$(mp_app_python || echo "${VENV_DIR}/bin/python")"
else
    if [ -x "${TRIM_APPDEST}/python/bin/python3" ]; then
        VENV_DIR="${TRIM_APPDEST}/python"
    elif [ -x "${TRIM_APPDEST}/venv/bin/python" ]; then
        VENV_DIR="${TRIM_APPDEST}/venv"
    else
        VENV_DIR="${TRIM_PKGVAR}/venv"
    fi
    PYTHON_BIN="/var/apps/python312/target/bin/python3"
    # 自带运行时与 venv 的差异：前者同时有 bin/python3 与 bin/python，后者通常
    # 只有 bin/python3（python3 -m venv 在部分版本不建 bin/python）。
    if [ -x "${VENV_DIR}/bin/python3" ]; then
        APP_PYTHON="${VENV_DIR}/bin/python3"
    else
        APP_PYTHON="${VENV_DIR}/bin/python"
    fi
fi

SUPERVISOR="${BIN_DIR}/supervisor.py"
SUPER_PID_FILE="${TRIM_PKGTMP}/${APP_NAME}-super.pid"
LOG_FILE="${TRIM_PKGVAR}/${APP_NAME}.log"
GATEWAY_SOCK="${TRIM_APPDEST}/${APP_NAME}.sock"

# 共享目录（用于写诊断日志，trim-cli 可读取）；未导出时跳过共享日志
SHARE_PATHS="${TRIM_DATA_SHARE_PATHS:-}"
if [ -n "$SHARE_PATHS" ]; then
    SHARE_LOG="${SHARE_PATHS%%:*}/${APP_NAME}-supervisor.log"
else
    SHARE_LOG=""
fi

# 端口（从 app.env 读取）
BACKEND_PORT=3002
FRONTEND_PORT=3005
if [ -f "${CONFIG_DIR}/app.env" ]; then
    v=$(grep -E '^PORT=' "${CONFIG_DIR}/app.env" | tail -1 | cut -d= -f2)
    [ -n "$v" ] && BACKEND_PORT="$v"
    v=$(grep -E '^NGINX_PORT=' "${CONFIG_DIR}/app.env" | tail -1 | cut -d= -f2)
    [ -n "$v" ] && FRONTEND_PORT="$v"
fi

LOG_MAX_SIZE=2097152
LOG_MAX_FILES=3

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"; }

is_pid_alive() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

rotate_logs() {
    if [ -f "$LOG_FILE" ]; then
        size=$(stat -c%s "$LOG_FILE" 2>/dev/null || stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)
        if [ "$size" -gt "$LOG_MAX_SIZE" ]; then
            [ -f "${LOG_FILE}.${LOG_MAX_FILES}" ] && rm -f "${LOG_FILE}.${LOG_MAX_FILES}"
            for i in $(seq $((LOG_MAX_FILES - 1)) -1 1); do
                [ -f "${LOG_FILE}.${i}" ] && mv "${LOG_FILE}.${i}" "${LOG_FILE}.$((i + 1))"
            done
            # copytruncate 语义：绝不能用 mv 轮转。supervisor 及其子进程（前端/代理）
            # 以 append 模式长期持有本文件的 fd，mv 之后它们仍写原 inode，日志会被
            # 割裂到 moviepilot.log.1；改为复制后清空，所有写入者继续落在同一 inode。
            cp -p "$LOG_FILE" "${LOG_FILE}.1" 2>/dev/null || true
            : > "$LOG_FILE"
            echo "$(date '+%Y-%m-%d %H:%M:%S') - Log rotated" >> "$LOG_FILE"
        fi
    fi
}

get_super_pid() {
    if [ -f "$SUPER_PID_FILE" ]; then
        p=$(cat "$SUPER_PID_FILE" 2>/dev/null)
        if is_pid_alive "$p"; then
            echo "$p"
            return
        fi
    fi
    # 必须用本应用的绝对路径匹配：只写 "bin/supervisor.py" 会命中其他 fnOS
    # 应用的同名脚本（它们同样位于 <appdir>/bin/supervisor.py），导致 is_running
    # 误判为"运行中"（应用永远起不来），stop 时更会误杀别的应用的主进程。
    pgrep -f "${BIN_DIR}/supervisor\.py" 2>/dev/null | head -1
}

is_running() {
    p=$(get_super_pid)
    [ -n "$p" ]
}

start_app() {
    if is_running; then
        return 0
    fi
    if [ ! -f "$SUPERVISOR" ]; then
        echo "错误：主管进程脚本不存在" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi
    if [ ! -x "$APP_PYTHON" ]; then
        echo "错误：Python 运行时不存在（${APP_PYTHON}），请重新安装应用" > "$TRIM_TEMP_LOGFILE"
        return 1
    fi
    rm -f "$GATEWAY_SOCK"
    log "启动主管进程 ..."
    nohup env \
        MP_SRC="$MP_SRC" VENV_DIR="$VENV_DIR" BIN_DIR="$BIN_DIR" \
        FRONTEND_DIR="$FRONTEND_DIR" CONFIG_DIR="$CONFIG_DIR" \
        BACKEND_PORT="$BACKEND_PORT" FRONTEND_PORT="$FRONTEND_PORT" \
        GATEWAY_SOCK="$GATEWAY_SOCK" LOG_FILE="$LOG_FILE" \
        SHARE_LOG="$SHARE_LOG" PYTHON_BIN="$PYTHON_BIN" \
        "$APP_PYTHON" "$SUPERVISOR" >> "$LOG_FILE" 2>&1 &
    echo $! > "$SUPER_PID_FILE"
    disown 2>/dev/null || true
    # 确认主管进程存活
    local i=0
    while [ $i -lt 20 ]; do   # 最长 10 秒
        if is_pid_alive "$(cat "$SUPER_PID_FILE")"; then
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done
    echo "错误：主管进程启动失败" > "$TRIM_TEMP_LOGFILE"
    tail -20 "$LOG_FILE" >> "$TRIM_TEMP_LOGFILE"
    rm -f "$SUPER_PID_FILE"
    return 1
}

stop_app() {
    p=$(get_super_pid)
    if [ -n "$p" ]; then
        log "停止主管进程 pid=$p ..."
        kill "$p" 2>/dev/null || true
        local timeout=30
        while is_pid_alive "$p" && [ $timeout -gt 0 ]; do
            sleep 1
            timeout=$((timeout - 1))
        done
        is_pid_alive "$p" && kill -9 "$p" 2>/dev/null || true
    fi
    # 兜底：清理残留的后端/前端/代理进程
    # 一律使用本应用的绝对路径（${MP_SRC}/${BIN_DIR}）匹配，避免误杀其他应用的
    # 同名脚本进程（后端以绝对路径启动，前端/代理脚本路径同样唯一）。
    pgrep -f "${MP_SRC}/app/main\.py" 2>/dev/null | xargs -r kill -9 2>/dev/null || true
    pgrep -f "${BIN_DIR}/frontend-server\.js" 2>/dev/null | xargs -r kill -9 2>/dev/null || true
    pgrep -f "${BIN_DIR}/gateway-proxy\.py" 2>/dev/null | xargs -r kill -9 2>/dev/null || true
    rm -f "$SUPER_PID_FILE" "$GATEWAY_SOCK"
}

mkdir -p "$TRIM_PKGTMP"
rotate_logs

case "${1:-}" in
start)
    log "=== start ==="
    start_app || exit 1
    log "=== started ==="
    exit 0
    ;;
stop)
    log "=== stop ==="
    stop_app
    log "=== stopped ==="
    exit 0
    ;;
restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;
status)
    if is_running; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Usage: $0 {start|stop|restart|status}" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
