#!/bin/bash
### MoviePilot 配置变更后
### 读取向导值并更新 app.env，随后重启服务使配置生效
set -u

APP_NAME="moviepilot"
CONFIG_DIR="${TRIM_PKGVAR}/config"
ENV_FILE="${CONFIG_DIR}/app.env"
MP_SRC="${TRIM_APPDEST}/mp"
BIN_DIR="${TRIM_APPDEST}/bin"

CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
# shellcheck source=lib.sh
. "${CMD_DIR}/lib.sh" 2>/dev/null || true

# 运行时解析：优先构建时打包的自带 Python 3.14（app/python），其次历史版本的
# venv，最后安装时在线创建的 venv。lib.sh 缺失时退回内联判断。
if command -v mp_runtime_dir >/dev/null 2>&1; then
    VENV_DIR="$(mp_runtime_dir || echo "${TRIM_PKGVAR}/venv")"
    APP_PYTHON="$(mp_app_python || echo "${VENV_DIR}/bin/python")"
else
    if [ -x "${TRIM_APPDEST}/python/bin/python3" ]; then
        VENV_DIR="${TRIM_APPDEST}/python"
    elif [ -x "${TRIM_APPDEST}/venv/bin/python" ]; then
        VENV_DIR="${TRIM_APPDEST}/venv"
    else
        VENV_DIR="${TRIM_PKGVAR}/venv"
    fi
    # 自带运行时与 venv 的差异：前者同时有 bin/python3 与 bin/python，后者通常
    # 只有 bin/python3。
    if [ -x "${VENV_DIR}/bin/python3" ]; then
        APP_PYTHON="${VENV_DIR}/bin/python3"
    else
        APP_PYTHON="${VENV_DIR}/bin/python"
    fi
fi

mkdir -p "${CONFIG_DIR}"

# 把配置目录与 app.env 归属到应用运行用户：
#   1) sed -i 会先写临时文件再 rename，文件不可写会失败；
#   2) app.env 内含明文超级管理员密码与 API_TOKEN，不应全局可读。
# 这里不递归：目录内的数据库/日志在安装或升级阶段已递归修正过属主。
mp_secure_config "${CONFIG_DIR}" "${ENV_FILE}" 0 || {
    # lib.sh 缺失（异常安装）时退回宽松权限，保证后端可写
    chmod 777 "${CONFIG_DIR}" 2>/dev/null || true
    if [ -f "${ENV_FILE}" ]; then
        chmod 666 "${ENV_FILE}" 2>/dev/null || true
    fi
}

# 更新端口（如果向导提供）
# 统一走 mp_env_upsert（存在则替换/不存在则追加）：值里可能含 / & | . 等字符，
# 用 sed 逐个手写转义迟早出错（早期密码用 "|" 分隔符，遇到含 & 的密码会写坏配置）。
if [ -n "${wizard_port:-}" ]; then
    mp_env_upsert "${ENV_FILE}" "PORT" "${wizard_port}"
fi
if [ -n "${wizard_nginx_port:-}" ]; then
    mp_env_upsert "${ENV_FILE}" "NGINX_PORT" "${wizard_nginx_port}"
fi

# 自更新开关（向导 select：1=开启 / 0=关闭）
if [ -n "${wizard_auto_update:-}" ]; then
    case "${wizard_auto_update}" in
        0|1) MP_AUTO_UPDATE_VALUE="${wizard_auto_update}" ;;
        *)   MP_AUTO_UPDATE_VALUE="1" ;;   # 非预期值一律按开启处理，避免误关
    esac
    mp_env_upsert "${ENV_FILE}" "MP_AUTO_UPDATE" "${MP_AUTO_UPDATE_VALUE}"
fi
# 补齐其它更新相关默认值（旧版本安装的 app.env 没有这些键）
mp_env_ensure "${ENV_FILE}" "MP_AUTO_UPDATE" "1"
mp_env_ensure "${ENV_FILE}" "MP_UPDATE_CHANNEL" "release"
mp_env_ensure "${ENV_FILE}" "MP_UPDATE_INTERVAL" "21600"
mp_env_ensure "${ENV_FILE}" "MP_UPDATE_DEPS" "1"

# 补齐安全密钥（见 lib.sh 的 mp_env_ensure_secret）。缺失会让后端回退到每次
# 启动随机的默认值：站点索引解不开（"No data available"）、登录态每次重启失效。
# 只补缺失项，已有值绝不覆盖 —— 轮换密钥会使旧签名与已加密数据作废。
mp_env_ensure_secret "${ENV_FILE}" "SECRET_KEY"
mp_env_ensure_secret "${ENV_FILE}" "RESOURCE_SECRET_KEY"

# 更新超级管理员密码（如向导要求修改）
if [ -n "${wizard_superuser_password:-}" ]; then
    mp_env_upsert "${ENV_FILE}" "SUPERUSER_PASSWORD" "${wizard_superuser_password}"
    # 同步到 MoviePilot 用户库（复用同一个初始化脚本，幂等）
    INIT_SCRIPT="${BIN_DIR}/mp_init_superuser.py"
    if [ -x "${APP_PYTHON}" ] && [ -f "${INIT_SCRIPT}" ]; then
        # 脚本自己会写 config.log（LOG_FILE），这里不能再重定向到同一文件（每行会
        # 重复两遍）。stdio 落到 PKGVAR 下的独立文件（该目录必定存在，避免重定向
        # 失败导致脚本根本没跑），未捕获异常的 traceback 仍可查。
        CONFIG_DIR="${CONFIG_DIR}" MP_SRC="${MP_SRC}" LOG_FILE="${TRIM_PKGVAR}/config.log" \
            "${APP_PYTHON}" "${INIT_SCRIPT}" \
            >> "${TRIM_PKGVAR}/config-init-stdio.log" 2>&1
    fi
fi

# 若应用正在运行，则重启使配置生效
if "${TRIM_APPDEST}/cmd/main" status >/dev/null 2>&1; then
    "${TRIM_APPDEST}/cmd/main" restart
fi

exit 0
