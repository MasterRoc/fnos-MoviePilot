appname               = moviepilot
version               = 1.0.6
display_name          = MoviePilot
desc                  = <b>NAS 媒体库自动化管理工具</b>，支持订阅、搜索、下载、媒体整理与刮削、媒体库刷新及消息通知等核心自动化流程。<br><br>🎬 <b>原生应用：</b>内置 Python 后端与 Web 前端，前后端运行于本地，通过 fnOS 统一网关嵌入桌面访问。<br><br>🐛 <b>问题反馈：</b><a href="https://github.com/jxxghp/MoviePilot/issues" target="_blank">GitHub Issues</a>

# 系统要求
platform              = all
os_min_version        = 1.1.3104
source                = thirdparty

# 开发者信息
maintainer            = MoviePilot
maintainer_url        = https://github.com/jxxghp/MoviePilot
distributor           = yukihana
distributor_url       = https://github.com/sushazhi/fnos-MoviePilot

# 安装控制
ctl_stop              = true

# JS SDK 支持
micro_app             = true

# 桌面图标配置
desktop_uidir         = ui
desktop_applaunchname = moviepilot.Application

# 依赖运行时
# 不声明 python312：本应用自带 CPython 3.14 运行时（app/python，构建时打包），
# MoviePilot V3 要求 requires-python >= 3.14，fnOS 的 python312 版本不够也用不上。
# 只需要 Node.js 跑前端静态服务。
install_dep_apps      = nodejs_v24

# 更新日志
changelog             = v1.0.6<br>1.修复“登录之后所有页面都读不到数据”这个根因缺陷：fnOS 统一网关会把请求里的 Authorization 头当成它自己的令牌校验，MoviePilot 的 JWT 校验不过，网关直接返回 200 text/plain “invalid token”，请求根本到不了应用。此前表现为仪表盘 CPU/内存/系统信息全空、关于页的认证资源版本与站点资源版本为空、推荐与订阅报“服务器返回了无效响应”、站点认证 No data available。现由网关代理注入的 polyfill 把该头改名为 X-MP-Auth（自定义头网关不校验），转发到前端服务前再还原成 Authorization 交给后端<br>2.说明：因该缺陷，此前 v1.0.3/v1.0.4 关于密钥与站点资源的判断并非故障根因（密钥仍需持久化，但并非“No data available”的原因）；如果你也遇到过“改了配置点保存没反应”“站点统计一直是 0”，同样由本条修复<br>3.新增回归：polyfill_smoke 增加 XHR/fetch 认证头改名与代理回译的用例，防止被改回去